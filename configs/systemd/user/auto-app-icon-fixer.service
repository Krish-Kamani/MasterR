[Unit]
Description=Auto App Icon Fixer on Boot
After=network-online.target default.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/krish_kamani/.local/bin/auto-app-icon-fixer --auto --wait-for-network 180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
